// The apron.chat site: static files in public/, served by the apron-chat
// Worker. Workers Builds deploys main to apron.chat, and pull requests get
// Preview URLs at <branch>-apron-chat.shazow.workers.dev.
//
// `npm run build` renders /protocol from shazow/apron's PROTOCOL.md. Wrangler
// runs it for `wrangler dev` and `wrangler deploy`, but Workers Builds ignores
// this setting: its Build command must also be `npm run build`.
{
  "name": "apron-chat",
  "compatibility_date": "2026-09-20",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    { "pattern": "apron.chat", "custom_domain": true }
  ],
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./public"
  }
}
